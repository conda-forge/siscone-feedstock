From 11a34c05043e353d92b79ab10211d92ec14f5825 Mon Sep 17 00:00:00 2001
From: Lindsey Gray <lindsey.gray@gmail.com>
Date: Fri, 25 Sep 2026 16:36:35 -0500
Subject: [PATCH] use imported getopt

---
 examples/CMakeLists.txt | 22 +++++++++-------------
 1 file changed, 9 insertions(+), 13 deletions(-)

diff --git a/examples/CMakeLists.txt b/examples/CMakeLists.txt
index de28b70..2cf2e93 100644
--- a/examples/CMakeLists.txt
+++ b/examples/CMakeLists.txt
@@ -24,19 +24,15 @@ target_link_libraries(spherical PUBLIC siscone_spherical)
 
 
 if(MSVC)
-  find_package(getopt CONFIG QUIET)
-
-  # first try newer getopt search, and if that fails, try the
-  # unofficial-getopt-win32 package
-  if(getopt_FOUND)
-    set(GETOPT_LIB
-      $<IF:$<TARGET_EXISTS:getopt::getopt_shared>,
-        getopt::getopt_shared,
-        getopt::getopt_static>)
-  else()
-    find_package(unofficial-getopt-win32 REQUIRED)
-    set(GETOPT_LIB unofficial::getopt-win32::getopt)
-  endif()
+  # conda-forge's getopt-win32 exports its target as unofficial::getopt-win32getopt
+  # (no "::" before getopt), so import the library from the host prefix directly.
+  file(TO_CMAKE_PATH "$ENV{PREFIX}/Library" GETOPT_ROOT)
+  add_library(getopt SHARED IMPORTED)
+  set_target_properties(getopt PROPERTIES
+    IMPORTED_IMPLIB "${GETOPT_ROOT}/lib/getopt.lib"
+    IMPORTED_LOCATION "${GETOPT_ROOT}/bin/getopt.dll"
+    INTERFACE_INCLUDE_DIRECTORIES "${GETOPT_ROOT}/include")
+  set(GETOPT_LIB getopt)
 
   foreach(t siscone_main siscone_area siscone_test times sample spherical)
     target_compile_definitions(${t} PUBLIC _CRT_SECURE_NO_WARNINGS)
-- 
